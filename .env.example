# ===============================================================
# Aura Living Apps - Environment Configuration Template
# Copy to .env or load into your CI/CD secret manager
# ===============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000

# Client App Credentials (Mobile Customer App)
FIREBASE_WEB_API_KEY=AIzaSyDummyWebApiKeyForClient0000000000
FIREBASE_WEB_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_ANDROID_API_KEY=AIzaSyDummyAndroidApiKeyClient00000000
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_IOS_API_KEY=AIzaSyDummyIosApiKeyClient00000000000000
FIREBASE_IOS_APP_ID=1:000000000000:ios:0000000000000000000000

# Admin App Credentials (Operations Staff)
FIREBASE_ADMIN_ANDROID_API_KEY=AIzaSyDummyAndroidApiKeyAdmin000000000
FIREBASE_ADMIN_ANDROID_APP_ID=1:000000000000:android:1111111111111111111111
FIREBASE_ADMIN_IOS_API_KEY=AIzaSyDummyIosApiKeyAdmin0000000000000000
FIREBASE_ADMIN_IOS_APP_ID=1:000000000000:ios:1111111111111111111111
